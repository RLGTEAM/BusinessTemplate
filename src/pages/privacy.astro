---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBusiness } from "@/lib/business";

const business = await getBusiness();
const { privacy } = business.content.legal;
---

<BaseLayout title={`${privacy.title} — ${business.data.name}`}>
  <main id="main">
    <p><a href="/">← <bdi>{business.data.name}</bdi></a></p>
    <h1>{privacy.title}</h1>
    <div>
      {privacy.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </main>
</BaseLayout>
